#!/usr/bin/env bash
#SBATCH --job-name=bk_v2_setup
#SBATCH --partition=lowprio
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=12:00:00
#SBATCH --output=/shares/amr.imm.uzh/data/projects/jaroge/urine_microbiome_bk/v2/logs/%x_%j.out
#SBATCH --error=/shares/amr.imm.uzh/data/projects/jaroge/urine_microbiome_bk/v2/logs/%x_%j.err

# One-off setup (needs internet): containers, references, MetaPhlAn DB, sample manifest.
# Idempotent: finished steps are skipped on rerun.
set -euo pipefail
source "${SCRIPTS:-/shares/amr.imm.uzh/data/projects/jaroge/urine_microbiome_bk/v2/scripts}/config.sh"
load_apptainer
mkdir -p "$LOGS" "$REF" "$SIF_LOCAL" "$TMP_ROOT" "$QC"
export APPTAINER_TMPDIR=$TMP_ROOT APPTAINER_CACHEDIR=$TMP_ROOT/apptainer_cache
THREADS=${SLURM_CPUS_PER_TASK:-8}

# ---- 1. containers -> containers.env ----------------------------------------
echo "# generated by 00_setup.sbatch $(date -Is)" > "$CONTAINERS_ENV.tmp"
while IFS='|' read -r tool image; do
  [[ -z "$tool" ]] && continue
  sif_name="${tool}_${image##*:}.sif"
  if [[ -s "$SIF_SHARED/$sif_name" ]]; then
    sif="$SIF_SHARED/$sif_name"
  else
    sif="$SIF_LOCAL/$sif_name"
    [[ -s "$sif" ]] || apptainer pull "$sif" "docker://$image"
  fi
  echo "[INFO] $tool -> $sif"
  echo "SIF_${tool^^}=$sif" >> "$CONTAINERS_ENV.tmp"
done <<< "$CONTAINER_SPECS"
mv "$CONTAINERS_ENV.tmp" "$CONTAINERS_ENV"
source "$CONTAINERS_ENV"

# ---- 2. miRBase hsa + bkv + jcv reference (DNA alphabet, single-line, first token as ID)
MIRREF=$REF/mirbase_$MIRBASE_VERSION
mkdir -p "$MIRREF"
for f in mature hairpin; do
  [[ -s "$MIRREF/$f.all.fa" ]] || curl -fsSL "$MIRBASE_URL/$f.fa" -o "$MIRREF/$f.all.fa"
  awk -v pre="$MIRNA_SPECIES_PREFIXES" '
    BEGIN{n=split(pre,p," "); for(i=1;i<=n;i++) keep[p[i]]=1}
    /^>/{id=substr($1,2); split(id,a,"-"); k=(a[1] in keep); if(k){if(seq!="")print seq; print ">"id; seq=""} next}
    k{s=toupper($0); gsub("U","T",s); seq=seq s}
    END{if(seq!="")print seq}' "$MIRREF/$f.all.fa" > "$MIRREF/$f.hsa_bkv.fa"
done
# fail loudly if the viral miRNAs are missing
for id in bkv-miR-B1-5p bkv-miR-B1-3p jcv-miR-J1-5p jcv-miR-J1-3p; do grep -qx ">$id" "$MIRREF/mature.hsa_bkv.fa" || { echo "[ERROR] $id missing"; exit 1; }; done
grep -qx ">bkv-mir-B1" "$MIRREF/hairpin.hsa_bkv.fa" || { echo "[ERROR] bkv-mir-B1 hairpin missing"; exit 1; }

# ---- 3. polyomavirus genomes + bowtie2 index ---------------------------------
VREF=$REF/polyomavirus
mkdir -p "$VREF"
if [[ ! -s "$VREF/bk_jc.1.bt2" ]]; then
  curl -fsSL "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=nuccore&id=${VIRUS_ACCS// /,}&rettype=fasta" -o "$VREF/bk_jc.fa"
  [[ $(grep -c '^>' "$VREF/bk_jc.fa") -eq $(wc -w <<< "$VIRUS_ACCS") ]] || { echo "[ERROR] virus download incomplete"; exit 1; }
  run bowtie2 bowtie2-build -q "$VREF/bk_jc.fa" "$VREF/bk_jc"
fi

# ---- 4. human bowtie2 index (shared, pre-built; only verified here) ---------
for ext in 1.bt2 rev.1.bt2; do
  [[ -s "$HOST_INDEX.$ext" ]] || { echo "[ERROR] missing $HOST_INDEX.$ext"; exit 1; }
done

# ---- 5. MetaPhlAn database (shared, pre-installed; only verified here) -------
for ext in pkl 1.bt2l rev.1.bt2l; do
  [[ -s "$MPA_DB/$MPA_INDEX.$ext" ]] || { echo "[ERROR] missing $MPA_DB/$MPA_INDEX.$ext"; exit 1; }
done

# ---- 6. sample manifest (metadata x miRNA FASTQ x NCBI SRA run table) ------
# NCBI SRA run table (primary archive for PRJNA projects); SampleName "R<N>" = sample number N
curl -fsSL --retry 5 --retry-delay 10 "https://trace.ncbi.nlm.nih.gov/Traces/sra-db-be/runinfo?acc=$SRA_PROJECT" \
  -o "$V2/sra_runinfo.csv"
python3 - "$METADATA" "$V2/sra_runinfo.csv" "$MIRNA_RAW" "$MG_RAW" "$MANIFEST" <<'PY'
import csv, os, sys
meta_f, sra_f, mirna_dir, mg_dir, out_f = sys.argv[1:]
ena = {r["SampleName"].strip().lstrip("R"): {"run_accession": r["Run"], "read_count": r["spots"]}
       for r in csv.DictReader(open(sra_f)) if r.get("Run")}
rows, problems = [], []
# tolerate Excel exports: BOM, CRLF, header case/whitespace, ; or , delimiter
text = open(meta_f, encoding="utf-8-sig", newline="").read().replace("\r\n", "\n").replace("\r", "\n")
delim = ";" if text.splitlines()[0].count(";") > text.splitlines()[0].count(",") else ","
reader = csv.DictReader(text.splitlines(), delimiter=delim)
reader.fieldnames = [h.strip().lower() for h in reader.fieldnames]
if not {"sample", "group"} <= set(reader.fieldnames):
    sys.exit(f"[ERROR] {meta_f}: need columns sample,group; found {reader.fieldnames!r}")
for r in reader:
    if not (r.get("sample") or "").strip():
        continue
    sid = r["sample"].strip().upper()
    num = sid.lstrip("S")
    group = {"treatment": "DNAemia", "control": "control"}[r["group"].strip().lower()]
    mirna = os.path.join(mirna_dir, f"{num}_R1_001.fastq.gz")
    run = ena.get(num, {}).get("run_accession", "")
    mg1 = os.path.join(mg_dir, f"{run}_1.fastq")
    mg2 = os.path.join(mg_dir, f"{run}_2.fastq")
    for p in (mirna, mg1, mg2):
        if not os.path.exists(p): problems.append(f"{sid}: missing {p}")
    rows.append([sid, num, group, mirna, run, ena.get(num, {}).get("read_count", ""), mg1, mg2])
if problems:
    sys.exit("[ERROR]\n" + "\n".join(problems))
rows.sort(key=lambda x: int(x[1]))
with open(out_f + ".tmp", "w") as fh:
    fh.write("\t".join(["sample_id","sample_num","group","mirna_r1","mg_run","mg_sra_read_pairs","mg_r1","mg_r2"]) + "\n")
    for x in rows: fh.write("\t".join(map(str, x)) + "\n")
os.replace(out_f + ".tmp", out_f)   # atomic: running array tasks never see a half-written manifest
print(f"[INFO] manifest: {len(rows)} samples, " +
      ", ".join(f"{g}={sum(r[2]==g for r in rows)}" for g in ("DNAemia","control")))
PY

# ---- 7. setup manifest -------------------------------------------------------
{
  echo "date	$(date -Is)"
  echo "job	${SLURM_JOB_ID:-interactive}"
  echo "mirbase_version	$MIRBASE_VERSION"
  echo "mirbase_species	$MIRNA_SPECIES_PREFIXES"
  echo "mature_n	$(grep -c '^>' "$MIRREF/mature.hsa_bkv.fa")"
  echo "hairpin_n	$(grep -c '^>' "$MIRREF/hairpin.hsa_bkv.fa")"
  echo "mature_md5	$(md5sum "$MIRREF/mature.all.fa" | cut -d' ' -f1)"
  echo "hairpin_md5	$(md5sum "$MIRREF/hairpin.all.fa" | cut -d' ' -f1)"
  echo "virus_accessions	$VIRUS_ACCS"
  echo "host_index	$HOST_INDEX"
  echo "metaphlan_db	$MPA_DB"
  echo "metaphlan_index	$MPA_INDEX"
  echo "metaphlan_pkl_md5	$(md5sum "$MPA_DB/$MPA_INDEX.pkl" | cut -d' ' -f1)"
  cat "$CONTAINERS_ENV" | grep '^SIF_' | tr '=' '\t'
} > "$V2/setup_manifest.tsv"
echo "[DONE] setup -> $V2/setup_manifest.tsv"
